# TravelLord AI - Environment Configuration Example

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=travellord_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration
# In production, use PostgreSQL with PostGIS:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/travellord_db
# For testing and standalone local development without PostgreSQL installed:
DATABASE_URL=sqlite+aiosqlite:///./travellord.db

# Routing Provider Configuration
# Supported providers: osrm (default open public / self-hosted instance), valhalla, simulated_fallback
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# External Data Feeds Configuration
# IMD Weather / NDMA / OpenStreetMap
IMD_WEATHER_ENDPOINT=https://mausam.imd.gov.in/api
ENABLE_LIVE_INTEGRATIONS=true
DATA_REFRESH_INTERVAL_MINUTES=30

# AI Assistant Provider (Optional Server-side LLM)
# If empty, rule-based and evidence-retrieval engine is used without fabricating LLM output
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Initial Seed Credentials (for initial deployment bootstrap only)
ADMIN_BOOTSTRAP_EMAIL=admin@travellord.ai
ADMIN_BOOTSTRAP_PASSWORD=AdminSecureTravelLord2026!
